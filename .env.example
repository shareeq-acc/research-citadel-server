# Server Configuration
PORT=8000

# Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# CORS & Domain
CORS_ORIGINS=http://localhost:3000
BASE_DOMAIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Email Configuration (for OTP/notifications)
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=your_email@gmail.com

# Cloudflare R2 Storage Configuration
# Get these from: https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Public URL for your R2 bucket (from bucket settings or custom domain)
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Database Reset (use with caution!)
RESET_DATABASE=false

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary Configuration (avatar uploads)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
