# Research Citadel — production. Copy to .env on the server, next to
# docker-compose.prod.yml. This file never leaves the machine.

# Where the app is reached. Used for CORS and for links in outgoing email.
PUBLIC_URL=https://citadel.shareeq.xyz

# Database. Not published to the host — only the server container reaches it.
DB_USER=citadel
DB_PASSWORD=
DB_NAME=citadel

# Sign the auth cookies. Long and random; changing it logs everybody out.
#   openssl rand -base64 48
JWT_SECRET=
# How long a login lasts. Required — the app will not boot without it.
JWT_EXPIRY=7d

GEMINI_API_KEY=

# Outbound email, for invitations and notifications.
EMAIL=
EMAIL_FROM=
EMAIL_PASSWORD=

# Uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File storage on Cloudflare R2. All five are required — the app refuses to
# start without them, so there is no half-configured state to trip over later.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The public read URL for the bucket, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Which images to run. The update timer pulls whatever these tags point at, and
# CI moves them on every green build of main. Pin a commit sha to roll back.
CLIENT_IMAGE=ghcr.io/shareeq-acc/research-citadel-client:main
SERVER_IMAGE=ghcr.io/shareeq-acc/research-citadel-server:main
